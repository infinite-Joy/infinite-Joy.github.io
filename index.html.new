<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Joydeep Bhattacharjee — Lead ML Engineer at Adobe. Author of 2 ML books. Building intelligent systems at scale.">
<meta name="author" content="Joydeep Bhattacharjee">
<title>Joydeep Bhattacharjee — ML Engineer · Author · Mentor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg: #08090b;
  --bg-elevated: #0f1114;
  --bg-card: #12141a;
  --bg-card-hover: #181b22;
  --surface: #1c1f28;
  --text: #e4e2de;
  --text-secondary: #8a877f;
  --text-muted: #555349;
  --accent: #e8c547;
  --accent-dim: rgba(232, 197, 71, 0.08);
  --accent-glow: rgba(232, 197, 71, 0.2);
  --green: #5cb97a;
  --blue: #5b8def;
  --coral: #e8726a;
  --border: #1f222b;
  --border-light: #282c38;
  --radius: 14px;
  --radius-sm: 8px;
  --font-display: 'Instrument Serif', Georgia, serif;
  --font-body: 'Outfit', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --max-w: 1200px;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::selection { background: var(--accent); color: var(--bg); }

/* ── GRAIN OVERLAY ── */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 10000;
  pointer-events: none;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 100px;
}

::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--text-muted); border-radius: 3px; }

/* ── NAV ── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  padding: 0 48px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(24px) saturate(1.4);
  -webkit-backdrop-filter: blur(24px) saturate(1.4);
  background: rgba(8, 9, 11, 0.75);
  border-bottom: 1px solid var(--border);
}

.nav-logo {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: -0.3px;
  text-decoration: none;
}

.nav-center {
  display: flex;
  gap: 28px;
  list-style: none;
}

.nav-center a {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.3px;
  transition: color 0.2s;
}

.nav-center a:hover { color: var(--text); }

.nav-cta {
  display: flex;
  align-items: center;
  gap: 16px;
}

.nav-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.status-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--green);
  animation: blink 2.5s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.btn-book {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 16px;
  border-radius: 50px;
  background: var(--accent);
  color: var(--bg);
  text-decoration: none;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.2px;
  transition: all 0.25s;
  border: none;
  cursor: pointer;
}

.btn-book:hover {
  box-shadow: 0 0 24px var(--accent-glow);
  transform: translateY(-1px);
}

/* ── HERO ── */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 140px 48px 100px;
  max-width: var(--max-w);
  margin: 0 auto;
  position: relative;
}

.hero-ambient {
  position: fixed;
  top: -200px;
  right: -200px;
  width: 700px;
  height: 700px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
  filter: blur(80px);
  opacity: 0.4;
  pointer-events: none;
  z-index: -1;
  animation: drift 12s ease-in-out infinite;
}

@keyframes drift {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-40px, 30px); }
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 28px;
  opacity: 0;
  animation: riseIn 0.7s 0.2s forwards;
}

.hero-tag::before {
  content: '';
  display: block;
  width: 24px;
  height: 1px;
  background: var(--accent);
}

.hero h1 {
  font-family: var(--font-display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 1;
  font-weight: 400;
  letter-spacing: -2px;
  margin-bottom: 28px;
  opacity: 0;
  animation: riseIn 0.7s 0.35s forwards;
}

.hero h1 em { font-style: italic; color: var(--accent); }

.hero-desc {
  font-size: 18px;
  color: var(--text-secondary);
  max-width: 560px;
  font-weight: 300;
  line-height: 1.75;
  margin-bottom: 48px;
  opacity: 0;
  animation: riseIn 0.7s 0.5s forwards;
}

.hero-stats {
  display: flex;
  gap: 40px;
  flex-wrap: wrap;
  opacity: 0;
  animation: riseIn 0.7s 0.65s forwards;
}

.hero-stat { display: flex; flex-direction: column; }

.hero-stat-val {
  font-family: var(--font-mono);
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}

.hero-stat-label {
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-top: 2px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  margin-top: 48px;
  opacity: 0;
  animation: riseIn 0.7s 0.8s forwards;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 28px;
  border-radius: 50px;
  background: var(--accent);
  color: var(--bg);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s;
  border: none;
  cursor: pointer;
}

.btn-primary:hover {
  box-shadow: 0 4px 30px var(--accent-glow);
  transform: translateY(-2px);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 28px;
  border-radius: 50px;
  background: transparent;
  color: var(--text);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  border: 1px solid var(--border);
  transition: all 0.3s;
}

.btn-secondary:hover {
  border-color: var(--accent);
  background: var(--accent-dim);
}

@keyframes riseIn {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── SECTION BASE ── */
.section {
  padding: 100px 48px;
  max-width: var(--max-w);
  margin: 0 auto;
}

.divider {
  height: 1px;
  max-width: var(--max-w);
  margin: 0 auto;
  background: linear-gradient(90deg, transparent, var(--border-light), transparent);
}

.section-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 2.5px;
  color: var(--text-muted);
  margin-bottom: 12px;
}

.section-heading {
  font-family: var(--font-display);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 400;
  letter-spacing: -1px;
  margin-bottom: 48px;
}

.section-heading em { font-style: italic; color: var(--accent); }

/* ── ABOUT: BENTO GRID ── */
.bento {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 14px;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.card:hover {
  background: var(--bg-card-hover);
  border-color: rgba(232, 197, 71, 0.12);
  transform: translateY(-3px);
}

.card-label {
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--accent);
  margin-bottom: 14px;
}

.card p {
  color: var(--text-secondary);
  font-size: 14.5px;
  line-height: 1.8;
}

.span-8 { grid-column: span 8; }
.span-4 { grid-column: span 4; }
.span-6 { grid-column: span 6; }
.span-3 { grid-column: span 3; }
.span-5 { grid-column: span 5; }
.span-7 { grid-column: span 7; }
.span-12 { grid-column: span 12; }

.photo-card {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--bg-card) 0%, #191c26 100%);
  min-height: 260px;
}

.avatar {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  object-fit: cover;
  opacity: 0.95;
}

.avatar-placeholder {
  width: 140px; height: 140px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 52px;
  font-style: italic;
  color: var(--accent);
  background: linear-gradient(135deg, #1a1c24 0%, #222530 100%);
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 6px;
}

.tag {
  padding: 5px 12px;
  border-radius: 20px;
  border: 1px solid var(--border);
  font-size: 12px;
  color: var(--text-secondary);
  font-family: var(--font-mono);
  font-size: 11px;
  transition: all 0.25s;
}

.tag:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-dim);
}

.stat-rows { display: flex; flex-direction: column; }

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px solid var(--border);
}

.stat-row:last-child { border-bottom: none; }

.stat-row .lbl { font-size: 13px; color: var(--text-muted); }

.stat-row .val {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 600;
}

/* ── BOOKS ── */
.books-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.book-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  display: flex;
  gap: 28px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.book-card:hover {
  background: var(--bg-card-hover);
  border-color: rgba(232, 197, 71, 0.12);
  transform: translateY(-3px);
}

.book-cover {
  width: 120px;
  min-width: 120px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.4);
}

.book-cover img {
  width: 100%;
  height: auto;
  display: block;
}

.book-info { flex: 1; }

.book-info h3 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 4px;
  letter-spacing: -0.2px;
}

.book-publisher {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.book-info p {
  font-size: 13.5px;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 16px;
}

.book-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.book-link {
  padding: 5px 14px;
  border-radius: 20px;
  border: 1px solid var(--border);
  font-size: 12px;
  color: var(--text-secondary);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
}

.book-link:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.book-stars {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* ── EXPERIENCE TIMELINE ── */
.timeline {
  max-width: 800px;
  position: relative;
  padding-left: 28px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 1px;
  background: linear-gradient(180deg, var(--accent), var(--border-light) 30%, var(--border-light));
}

.tl-item {
  padding: 0 0 36px 28px;
  position: relative;
}

.tl-item:last-child { padding-bottom: 0; }

.tl-item::before {
  content: '';
  position: absolute;
  left: -32px;
  top: 8px;
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--accent);
}

.tl-item.past::before { background: var(--text-muted); box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--border); }

.tl-date {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 0.8px;
  margin-bottom: 4px;
}

.tl-role {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 2px;
}

.tl-company {
  font-size: 14px;
  color: var(--accent);
  margin-bottom: 8px;
}

.tl-desc {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 600px;
}

.tl-chips {
  display: flex;
  gap: 6px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.chip {
  padding: 3px 10px;
  border-radius: 6px;
  background: var(--accent-dim);
  font-size: 11px;
  color: var(--accent);
  font-family: var(--font-mono);
}

/* ── BLOG ── */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.blog-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  display: block;
}

.blog-card:hover {
  background: var(--bg-card-hover);
  transform: translateY(-3px);
  border-color: rgba(232, 197, 71, 0.12);
}

.blog-date {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 0.5px;
  margin-bottom: 10px;
}

.blog-card h3 {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 8px;
  letter-spacing: -0.2px;
  line-height: 1.4;
}

.blog-card p {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.7;
}

.blog-read-more {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 14px;
  font-size: 12px;
  color: var(--accent);
  font-family: var(--font-mono);
  letter-spacing: 0.5px;
}

.blog-read-more .arr { transition: transform 0.25s; }
.blog-card:hover .blog-read-more .arr { transform: translateX(4px); }

/* ── OPEN SOURCE ── */
.oss-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.oss-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  text-decoration: none;
  color: inherit;
  display: block;
}

.oss-card:hover {
  background: var(--bg-card-hover);
  transform: translateY(-3px);
  border-color: rgba(232, 197, 71, 0.12);
}

.oss-name {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.lang-dot {
  width: 9px; height: 9px;
  border-radius: 50%;
  display: inline-block;
}

.lang-rust { background: #dea584; }
.lang-python { background: #3572A5; }
.lang-jupyter { background: #DA5B0B; }

.oss-card p {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 14px;
}

.oss-meta {
  display: flex;
  gap: 14px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-muted);
}

.oss-meta span {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* ── TECH STACK ── */
.stack-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.stack-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  transition: all 0.3s;
}

.stack-card:hover {
  background: var(--bg-card-hover);
  border-color: rgba(232, 197, 71, 0.08);
}

.stack-category {
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--accent);
  margin-bottom: 14px;
}

.stack-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stack-item {
  font-size: 13.5px;
  color: var(--text-secondary);
  padding-left: 14px;
  position: relative;
}

.stack-item::before {
  content: '›';
  position: absolute;
  left: 0;
  color: var(--text-muted);
}

/* ── MENTORSHIP / TOPMATE ── */
.mentor-card {
  background: linear-gradient(135deg, var(--bg-card) 0%, #17192280 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  position: relative;
  overflow: hidden;
}

.mentor-card::before {
  content: '';
  position: absolute;
  top: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
}

.mentor-content h3 {
  font-family: var(--font-display);
  font-size: 32px;
  margin-bottom: 10px;
  font-weight: 400;
}

.mentor-content h3 em { font-style: italic; color: var(--accent); }

.mentor-content p {
  font-size: 15px;
  color: var(--text-secondary);
  max-width: 520px;
  line-height: 1.7;
  margin-bottom: 24px;
}

.mentor-services {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.service-tag {
  padding: 6px 14px;
  border-radius: 8px;
  background: var(--accent-dim);
  font-size: 13px;
  color: var(--accent);
  font-weight: 500;
}

.mentor-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.btn-topmate {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 36px;
  border-radius: 50px;
  background: var(--accent);
  color: var(--bg);
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s;
  white-space: nowrap;
}

.btn-topmate:hover {
  box-shadow: 0 4px 40px var(--accent-glow);
  transform: translateY(-2px) scale(1.02);
}

.topmate-note {
  font-size: 12px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

/* ── CONTACT ── */
.contact-section {
  text-align: center;
  padding: 100px 48px 60px;
  max-width: var(--max-w);
  margin: 0 auto;
}

.contact-section .section-heading { margin-bottom: 12px; }

.contact-subtitle {
  font-size: 16px;
  color: var(--text-secondary);
  margin-bottom: 40px;
  font-weight: 300;
}

.contact-links {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border-radius: 50px;
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s;
}

.contact-link:hover {
  border-color: var(--accent);
  background: var(--accent-dim);
  transform: translateY(-2px);
}

.contact-link svg {
  width: 18px; height: 18px;
  fill: currentColor;
}

/* ── FOOTER ── */
footer {
  padding: 32px 48px;
  max-width: var(--max-w);
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border);
}

footer p {
  font-size: 12px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

footer a {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 12px;
  font-family: var(--font-mono);
}

footer a:hover { color: var(--accent); }

/* ── SCROLL REVEAL ── */
.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .span-8, .span-7, .span-6, .span-5, .span-4, .span-3 { grid-column: span 12; }
  .books-grid, .blog-grid, .oss-grid { grid-template-columns: 1fr; }
  .stack-grid { grid-template-columns: repeat(2, 1fr); }
  .mentor-card { flex-direction: column; text-align: center; padding: 36px; }
  .mentor-content p { max-width: 100%; }
  .mentor-services { justify-content: center; }
}

@media (max-width: 768px) {
  nav { padding: 0 20px; }
  .nav-center { display: none; }
  .hero, .section { padding-left: 20px; padding-right: 20px; }
  .hero h1 { font-size: 40px; letter-spacing: -1px; }
  .hero-stats { gap: 24px; }
  .hero-actions { flex-direction: column; }
  .btn-primary, .btn-secondary { justify-content: center; }
  .book-card { flex-direction: column; align-items: center; text-align: center; }
  .book-links { justify-content: center; }
  .stack-grid { grid-template-columns: 1fr; }
  .contact-links { flex-direction: column; align-items: center; }
  .contact-section, footer { padding-left: 20px; padding-right: 20px; }
  footer { flex-direction: column; gap: 8px; }
}

@media (max-width: 480px) {
  .nav-status { display: none; }
}
</style>
</head>
